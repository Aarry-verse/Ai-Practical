Practical 10 – BFS for Blocks World
Aim: To implement Breadth First Search (BFS) for solving the Blocks World problem.
Python Code
from collections import deque

start = (('A','B','C'),)
goal = (('C','B','A'),)

q = deque([(start, 0)])
visited = {start}

while q:
    state, moves = q.popleft()

    if state == goal:
        print("Goal Reached")
        print("Total Moves:", moves)
        break

    for i, stack in enumerate(state):
        block = stack[-1]
        rest = list(state)
        rest.pop(i)

        states = [tuple(sorted(rest + [(block,)]))]

        for j in range(len(rest)):
            temp = rest.copy()
            temp[j] += (block,)
            states.append(tuple(sorted(temp)))

        for new in states:
            if new not in visited:
                visited.add(new)
                q.append((new, moves + 1))
